create database empresa;
-- drop database empresa;
use empresa;

create table Empleados(
IDEmpleado int auto_increment primary key not null,
Nombre varchar(18),
Apellido varchar(20) not null,
Sector enum("Adm","Ventas", "Compras", "RRHH") ,
Edad int(2) default 35 not null,
Sexo enum("F","M"),
Barrio_Vivienda varchar(25) default "Belgrano",
CodPostal int(4),
Ingreso year not null,
Sueldo float not null,
Antiguedad float not null default 250,
Celular varchar(25)
);

