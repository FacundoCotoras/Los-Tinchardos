select Clientes.Nombre, count(Ventas.ID_Venta) as cantidadventas
from Clientes
inner join Ventas
on Clientes.ID_Cliente = Ventas.ID_Cliente
group by Clientes.Nombre, Clientes.ID_Cliente
order by cantidadventas desc
limit 1;

select Productos.Nombre, count(ProductosVentas.Cantidad) as cantidadproductos
from Productos
inner join ProductosVentas
on Productos.ID_Producto = ProductosVentas.ID_Producto
group by Productos.Nombre
order by cantidadproductos desc
limit 1;


select Carniceros.Nombre as Carnicero_mas_exitoso
from carniceros
where Carniceros.ID_Carnicero = (select ventas.ID_Carnicero from ventas group by ventas.ID_Carnicero order by count(ventas.ID_Carnicero) limit 1);


