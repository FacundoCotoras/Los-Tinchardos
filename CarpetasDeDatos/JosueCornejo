CREATE DATABASE IF NOT EXISTS TowerDefense;

USE TowerDefense;

CREATE TABLE Players (
    IDPlayer INT AUTO_INCREMENT PRIMARY KEY,
    Usuario VARCHAR(50) NOT NULL,
    Correo VARCHAR(100) NOT NULL,
    FechaRegistro DATETIME NOT NULL,
    NivelActual INT NOT NULL
);


CREATE TABLE Sessions (
    IDSession INT AUTO_INCREMENT PRIMARY KEY,
    IDPlayer INT NOT NULL,
    FechaInicio DATETIME NOT NULL,
    FechaFin DATETIME,
    TiempoDefendido INT NOT NULL,
    DificultadInicial VARCHAR(30) NOT NULL,
    FOREIGN KEY (IDPlayer) REFERENCES Players(IDPlayer)
);


CREATE TABLE PowerUps (
    IDPowerUp INT AUTO_INCREMENT PRIMARY KEY,
    Nombre VARCHAR(50) NOT NULL,
    Efecto VARCHAR(100) NOT NULL,
    Duracion INT NOT NULL,
    Descripcion VARCHAR(200) NOT NULL
);


CREATE TABLE Inventory (
    IDInventory INT AUTO_INCREMENT PRIMARY KEY,
    IDSession INT NOT NULL,
    IDPowerUp INT NOT NULL,
    Cantidad INT NOT NULL,
    Estado VARCHAR(30) NOT NULL,
    FOREIGN KEY (IDSession) REFERENCES Sessions(IDSession),
    FOREIGN KEY (IDPowerUp) REFERENCES PowerUps(IDPowerUp)
);


CREATE TABLE Waves (
    IDWave INT AUTO_INCREMENT PRIMARY KEY,
    IDSession INT NOT NULL,
    NumeroWave INT NOT NULL,
    Dificultad VARCHAR(30) NOT NULL,
    EnemigosSpawneados INT NOT NULL,
    FOREIGN KEY (IDSession) REFERENCES Sessions(IDSession)
);

CREATE TABLE DefenseTypes (
    IDDefenseType INT AUTO_INCREMENT PRIMARY KEY,
    Nombre VARCHAR(50) NOT NULL,
    Costo INT NOT NULL,
    DañoBase INT NOT NULL,
    VidaBase INT NOT NULL,
    Rango INT NOT NULL
);


CREATE TABLE DefenseInstances (
    IDDefenseInstance INT AUTO_INCREMENT PRIMARY KEY,
    IDSession INT NOT NULL,
    IDDefenseType INT NOT NULL,
    x INT NOT NULL,
    y INT NOT NULL,
    VidaActual INT NOT NULL,
    EstadoActual VARCHAR(30) NOT NULL,
    FOREIGN KEY (IDSession) REFERENCES Sessions(IDSession),
    FOREIGN KEY (IDDefenseType) REFERENCES DefenseTypes(IDDefenseType)
);


CREATE TABLE EnemyTypes (
    IDEnemyType INT AUTO_INCREMENT PRIMARY KEY,
    Nombre VARCHAR(50) NOT NULL,
    VidaBase INT NOT NULL,
    Daño INT NOT NULL,
    Velocidad INT NOT NULL,
    Resistencia INT NOT NULL,
    TipoAtaque VARCHAR(30) NOT NULL
);


CREATE TABLE Bosses (
    IDBoss INT AUTO_INCREMENT PRIMARY KEY,
    IDEnemyType INT NOT NULL,
    HabilidadEspecial VARCHAR(200) NOT NULL,
    FOREIGN KEY (IDEnemyType) REFERENCES EnemyTypes(IDEnemyType)
);


CREATE TABLE EnemyInstances (
    IDEnemyInstance INT AUTO_INCREMENT PRIMARY KEY,
    IDSession INT NOT NULL,
    IDEnemyType INT NOT NULL,
    IDWave INT NOT NULL,
    x INT NOT NULL,
    y INT NOT NULL,
    VidaActual INT NOT NULL,
    FOREIGN KEY (IDSession) REFERENCES Sessions(IDSession),
    FOREIGN KEY (IDEnemyType) REFERENCES EnemyTypes(IDEnemyType),
    FOREIGN KEY (IDWave) REFERENCES Waves(IDWave)
);


CREATE TABLE Resources (
    IDResource INT AUTO_INCREMENT PRIMARY KEY,
    IDSession INT NOT NULL,
    Tipo VARCHAR(30) NOT NULL,
    Cantidad INT NOT NULL,
    FOREIGN KEY (IDSession) REFERENCES Sessions(IDSession)
);


CREATE TABLE SessionResults (
    IDResult INT AUTO_INCREMENT PRIMARY KEY,
    IDSession INT NOT NULL,
    MotivoFin VARCHAR(100) NOT NULL,
    VidaTorre INT NOT NULL,
    DefensasDestruidas INT NOT NULL,
    EnemigosEliminados INT NOT NULL,
    FOREIGN KEY (IDSession) REFERENCES Sessions(IDSession)
);


CREATE TABLE LeaderBoards (
    IDLeaderBoard INT AUTO_INCREMENT PRIMARY KEY,
    IDSession INT NOT NULL,
    MotivoFin VARCHAR(100) NOT NULL,
    VidaTorre INT NOT NULL,
    DefensasDestruidas INT NOT NULL,
    EnemigosEliminados INT NOT NULL,
    FOREIGN KEY (IDSession) REFERENCES Sessions(IDSession)
);


CREATE TABLE CombatLogs (
    IDCombatLog INT AUTO_INCREMENT PRIMARY KEY,
    IDSession INT NOT NULL,
    TimeStamp DATETIME NOT NULL,
    TipoAccion VARCHAR(50) NOT NULL,
    Origen VARCHAR(100),
    Destino VARCHAR(100),
    ValorImpacto INT,
    Coordenadas VARCHAR(100),
    FOREIGN KEY (IDSession) REFERENCES Sessions(IDSession)
    );
