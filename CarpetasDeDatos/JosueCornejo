CREATE DATABASE IF NOT EXISTS defensa_base;
USE defensa_base;

CREATE TABLE Players (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE
);

CREATE TABLE Sessions (
    id INT AUTO_INCREMENT PRIMARY KEY,
    player_id INT NOT NULL,
    fecha_inicio DATETIME NOT NULL,
    fecha_fin DATETIME,
    tiempo_defendido INT NOT NULL,
    dificultad_inicial INT NOT NULL,
    
    FOREIGN KEY (player_id) REFERENCES Players(id),
    CHECK (tiempo_defendido >= 0),
    CHECK (dificultad_inicial >= 1)
);

CREATE TABLE DefenseTypes (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    costo_energia INT NOT NULL,
    dano_base INT NOT NULL,
    vida_base INT NOT NULL,
    rango INT NOT NULL,
    
    CHECK (costo_energia >= 0),
    CHECK (dano_base >= 0),
    CHECK (vida_base > 0),
    CHECK (rango > 0)
);

CREATE TABLE DefenseInstances (
    id INT AUTO_INCREMENT PRIMARY KEY,
    session_id INT NOT NULL,
    type_id INT NOT NULL,
    x INT NOT NULL,
    y INT NOT NULL,
    vida_actual INT NOT NULL,
    estado_operativo VARCHAR(30) NOT NULL,
    
    FOREIGN KEY (session_id) REFERENCES Sessions(id),
    FOREIGN KEY (type_id) REFERENCES DefenseTypes(id),
    CHECK (vida_actual >= 0)
);

CREATE TABLE EnemyTypes (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    vida_base INT NOT NULL,
    dano_ataque INT NOT NULL,
    velocidad INT NOT NULL,
    resistencia INT NOT NULL,
    
    CHECK (vida_base > 0),
    CHECK (dano_ataque >= 0),
    CHECK (velocidad >= 0),
    CHECK (resistencia >= 0)
);

CREATE TABLE EnemyInstances (
    id INT AUTO_INCREMENT PRIMARY KEY,
    session_id INT NOT NULL,
    type_id INT NOT NULL,
    x INT NOT NULL,
    y INT NOT NULL,
    vida_actual INT NOT NULL,
    oleada INT NOT NULL,
    origen VARCHAR(100) NOT NULL,
    
    FOREIGN KEY (session_id) REFERENCES Sessions(id),
    FOREIGN KEY (type_id) REFERENCES EnemyTypes(id),
    CHECK (vida_actual >= 0),
    CHECK (oleada > 0)
);

CREATE TABLE CombatLogs (
    id INT AUTO_INCREMENT PRIMARY KEY,
    session_id INT NOT NULL,
    timestamp DATETIME NOT NULL,
    tipo_accion VARCHAR(50) NOT NULL,
    origen_id INT,
    destino_id INT,
    valor_impacto INT NOT NULL,
    coordenadas VARCHAR(100) NOT NULL,
    
    FOREIGN KEY (session_id) REFERENCES Sessions(id),
    CHECK (valor_impacto >= 0)
);

CREATE TABLE SessionResults (
    id INT AUTO_INCREMENT PRIMARY KEY,
    session_id INT NOT NULL UNIQUE,
    motivo_fin VARCHAR(100) NOT NULL,
    integridad_base_final INT NOT NULL,
    defensas_destruidas INT NOT NULL,
    enemigos_eliminados INT NOT NULL,
    
    FOREIGN KEY (session_id) REFERENCES Sessions(id),
    CHECK (integridad_base_final >= 0),
    CHECK (defensas_destruidas >= 0),
    CHECK (enemigos_eliminados >= 0)
);
